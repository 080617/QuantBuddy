# FutuOpenD connection (no login password, unlock password, token, or real account data)
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_MARKET=CN
FUTU_TRD_ENV=SIMULATE

# Optional. Leave empty to require automatic selection of exactly one active CN simulated account.
FUTU_ACCOUNT_ID=

# Write operations are disabled by default. This can only enable SIMULATE orders.
FUTU_ENABLE_SIMULATED_ORDERS=false
FUTU_MAX_SIMULATED_ORDER_AMOUNT=100000
